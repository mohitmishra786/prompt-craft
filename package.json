{
  "name": "prompt-craft",
  "displayName": "Prompt Craft Pro",
  "description": "The Ultimate AI Prompting Companion. Generate context-aware prompts for ChatGPT, Claude, and Copilot by analyzing your code, architecture, and errors.",
  "version": "0.1.0",
  "publisher": "mohitmishra",
  "icon": "prompt-craft.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "prompts",
    "ai",
    "groq",
    "analysis",
    "errors"
  ],
  "activationEvents": [
    "workspaceContains:README.md"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohitmishra786/prompt-craft"
  },
  "bugs": {
    "url": "https://github.com/mohitmishra786/prompt-craft/issues"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "prompt-craft-sidebar",
          "title": "Prompt Craft",
          "icon": "prompt-craft.png"
        }
      ]
    },
    "views": {
      "prompt-craft-sidebar": [
        {
          "type": "webview",
          "id": "promptCraft.sidebar",
          "name": "Prompt Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "prompt-craft.generateErrorPrompt",
        "title": "Prompt Craft: Generate Error Prompt"
      },
      {
        "command": "prompt-craft.analyzeProject",
        "title": "Prompt Craft: Analyze Project and Generate Prompts"
      },
      {
        "command": "prompt-craft.selectProvider",
        "title": "Prompt Craft: Select LLM Provider"
      },
      {
        "command": "prompt-craft.testProvider",
        "title": "Prompt Craft: Test Provider Connection"
      },
      {
        "command": "prompt-craft.reloadProviders",
        "title": "Prompt Craft: Reload Providers from Settings"
      },
      {
        "command": "prompt-craft.showProviderStatus",
        "title": "Prompt Craft: Show Provider Status"
      }
    ],
    "configuration": {
      "title": "Prompt Craft",
      "properties": {
        "promptCraft.activeProvider": {
          "type": "string",
          "enum": [
            "groq",
            "openai",
            "azure-openai",
            "claude",
            "ollama"
          ],
          "default": "groq",
          "description": "Active LLM provider to use for prompt generation",
          "scope": "application"
        },
        "promptCraft.groqApiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Groq API key for LLM-enhanced prompt generation. Get a key from [groq.com](https://groq.com). Leave blank to use template-based generation.",
          "scope": "application"
        },
        "promptCraft.requestTimeoutMs": {
          "type": "number",
          "default": 5000,
          "description": "Timeout for LLM API requests in milliseconds.",
          "scope": "application",
          "minimum": 1000,
          "maximum": 20000
        },
        "promptCraft.openai.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "OpenAI API key. Get a key from [platform.openai.com](https://platform.openai.com).",
          "scope": "application"
        },
        "promptCraft.openai.model": {
          "type": "string",
          "enum": [
            "gpt-4",
            "gpt-4-turbo",
            "gpt-3.5-turbo"
          ],
          "default": "gpt-4-turbo",
          "description": "OpenAI model to use",
          "scope": "application"
        },
        "promptCraft.openai.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Timeout for OpenAI API requests in milliseconds.",
          "scope": "application",
          "minimum": 1000,
          "maximum": 60000
        },
        "promptCraft.azureOpenAI.endpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "Azure OpenAI endpoint URL (e.g., https://your-resource.openai.azure.com)",
          "scope": "application"
        },
        "promptCraft.azureOpenAI.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Azure OpenAI API key. Leave blank to use Azure CLI or Managed Identity authentication.",
          "scope": "application"
        },
        "promptCraft.azureOpenAI.deploymentName": {
          "type": "string",
          "default": "",
          "description": "Azure OpenAI deployment name",
          "scope": "application"
        },
        "promptCraft.azureOpenAI.apiVersion": {
          "type": "string",
          "default": "2024-02-01",
          "description": "Azure OpenAI API version",
          "scope": "application"
        },
        "promptCraft.azureOpenAI.authMethod": {
          "type": "string",
          "enum": [
            "apiKey",
            "azureCli",
            "managedIdentity"
          ],
          "default": "apiKey",
          "description": "Authentication method for Azure OpenAI",
          "scope": "application"
        },
        "promptCraft.azureOpenAI.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Timeout for Azure OpenAI API requests in milliseconds.",
          "scope": "application",
          "minimum": 1000,
          "maximum": 60000
        },
        "promptCraft.ollama.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Ollama local provider support",
          "scope": "application"
        },
        "promptCraft.ollama.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/api",
          "description": "Ollama API base URL",
          "scope": "application"
        },
        "promptCraft.ollama.model": {
          "type": "string",
          "default": "llama3",
          "description": "Ollama model to use (e.g. llama3, codellama, mistral)",
          "scope": "application"
        },
        "promptCraft.ollama.timeout": {
          "type": "number",
          "default": 60000,
          "description": "Timeout for Ollama API requests in milliseconds.",
          "scope": "application",
          "minimum": 1000,
          "maximum": 300000
        },
        "promptCraft.claude.apiKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Anthropic Claude API key. Get a key from [console.anthropic.com](https://console.anthropic.com).",
          "scope": "application"
        },
        "promptCraft.claude.model": {
          "type": "string",
          "default": "claude-3-sonnet-20240229",
          "enum": [
            "claude-3-opus-20240229",
            "claude-3-sonnet-20240229",
            "claude-3-haiku-20240307",
            "claude-2.1",
            "claude-2.0"
          ],
          "description": "Anthropic Claude model to use",
          "scope": "application"
        },
        "promptCraft.claude.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Timeout for Claude API requests in milliseconds.",
          "scope": "application",
          "minimum": 1000,
          "maximum": 60000
        },
        "promptCraft.telemetry.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable anonymous telemetry to help improve the extension."
        },
        "promptCraft.customTemplates": {
          "type": "array",
          "default": [],
          "description": "User-defined prompt templates.",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "template": { "type": "string" },
              "type": { "type": "string", "enum": ["error", "project"] }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "test": "node ./out/test/runTest.js",
    "package": "npx vsce package",
    "lint": "echo 'No linter configured'"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.84.0",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^6.2.2",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.0",
    "axios": "^1.7.2"
  }
}
